# GitHub Actions Secrets template for .github/workflows/deploy-gcp-netlify.yml
# 실제 키를 이 파일에 넣거나 커밋하지 마세요.
# GitHub Secrets 등록 위치:
# https://github.com/LxNx-Hn/chatbot-with-kt-dgucenter/settings/secrets/actions

# GCP_SERVICE_ACCOUNT_KEY
# 용도: GitHub Actions가 GCP Cloud Run, Artifact Registry, Secret Manager를 제어하기 위한 서비스 계정 JSON 키 전체.
# 발급: Google Cloud Console > IAM 및 관리자 > 서비스 계정 > 대상 서비스 계정 > 키 > 키 추가 > 새 키 만들기 > JSON.
# 공식 문서: https://cloud.google.com/iam/docs/keys-create-delete
# 콘솔: https://console.cloud.google.com/iam-admin/serviceaccounts
GCP_SERVICE_ACCOUNT_KEY=

# NVIDIA_API_KEY
# 용도: Cloud Run 게이트웨이가 NVIDIA NIM API를 호출하는 데 사용.
# 발급: NVIDIA Build > API Keys.
# 공식 발급 페이지: https://build.nvidia.com/settings/api-keys
# NIM 개발자 안내: https://developer.nvidia.com/nim
NVIDIA_API_KEY=

# SERVICE_KEY
# 용도: 공공데이터/정책 API 호출용 serviceKey.
# 발급: 공공데이터포털 로그인 > 사용할 OpenAPI 검색 > 활용신청 > 마이페이지/인증키 발급현황에서 확인.
# 공식 포털: https://www.data.go.kr/
# OpenAPI 호출/인증키 안내 PDF: https://www.data.go.kr/images/biz/swagger-guide/multi_swagger_guide.pdf
SERVICE_KEY=

# NAVER_CLIENT_ID
# NAVER_CLIENT_SECRET
# 용도: trend 카테고리에서 네이버 데이터랩 통합 검색어 트렌드 API 호출.
# 발급: NAVER Developers > Application > 애플리케이션 등록 > 데이터랩/통합 검색어 트렌드 API 사용 설정.
# 공식 데이터랩 문서: https://developers.naver.com/docs/serviceapi/datalab/search/search.md
# 애플리케이션 등록: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# NETLIFY_AUTH_TOKEN
# 용도: GitHub Actions가 기존 Netlify 사이트에 프론트엔드를 배포하는 데 사용.
# 발급: Netlify User settings > Applications > Personal access tokens > New access token.
# 공식 문서: https://docs.netlify.com/api-and-cli-guides/cli-guides/get-started-with-cli/#obtain-a-token-in-the-netlify-ui
# 직접 이동: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# NETLIFY_SITE_ID
# 용도: 배포 대상 Netlify 사이트 식별자. Netlify UI에서는 Project ID 또는 Site ID로 표시됨.
# 확인: Netlify 사이트 > Project configuration > General > Project details > Project information > Project ID.
# 공식 문서: https://docs.netlify.com/api-and-cli-guides/cli-guides/get-started-with-cli/#link-with-an-environment-variable
NETLIFY_SITE_ID=
