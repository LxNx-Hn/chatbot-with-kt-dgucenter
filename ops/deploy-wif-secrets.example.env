# GitHub Actions Secrets template for keyless GCP deployment.
# 실제 키를 이 파일에 넣거나 커밋하지 마세요.
# GitHub Secrets 등록 위치:
# https://github.com/LxNx-Hn/chatbot-with-kt-dgucenter/settings/secrets/actions

# GCP_PROJECT_ID
# 용도: 배포 대상 GCP 프로젝트 ID.
# 확인: Google Cloud Console 프로젝트 선택기 또는 Cloud Shell에서 `gcloud config get-value project`.
GCP_PROJECT_ID=

# GCP_WORKLOAD_IDENTITY_PROVIDER
# 용도: GitHub Actions OIDC를 신뢰하는 GCP Workload Identity Provider 리소스 이름.
# 형식: projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/github-actions/providers/github
# 설정 문서: ops/docs/GCP_Workload_Identity_Federation_설정.md
GCP_WORKLOAD_IDENTITY_PROVIDER=

# GCP_SERVICE_ACCOUNT_EMAIL
# 용도: GitHub Actions가 Workload Identity Federation으로 가장할 서비스 계정 이메일.
# 예시: dgu-github-deployer@YOUR_GCP_PROJECT_ID.iam.gserviceaccount.com
GCP_SERVICE_ACCOUNT_EMAIL=

# NVIDIA_API_KEY
# 용도: Cloud Run 게이트웨이가 NVIDIA NIM API를 호출하는 데 사용.
# 발급: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# SERVICE_KEY
# 용도: 공공데이터/정책 API 호출용 serviceKey.
# 발급: https://www.data.go.kr/
SERVICE_KEY=

# NAVER_CLIENT_ID
# NAVER_CLIENT_SECRET
# 용도: trend 카테고리에서 네이버 데이터랩 통합 검색어 트렌드 API 호출.
# 발급: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# NETLIFY_AUTH_TOKEN
# 용도: GitHub Actions가 기존 Netlify 사이트에 프론트엔드를 배포하는 데 사용.
# 발급: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# NETLIFY_SITE_ID
# 용도: 배포 대상 Netlify 사이트 식별자.
# 확인: Netlify 사이트 > Project configuration > General > Project information > Project ID.
NETLIFY_SITE_ID=
